<div class="container container--wide content-page">
  <article class="prose">
    <h1>404 — Page not found</h1>
    <p>The page you requested could not be found. It may have moved, or the link may be incorrect.</p>
    <p>Try one of the section overviews:</p>
    <ul>
      {%- for s in site.sections %}
      <li><a href="{{ site.url }}{{ s.url }}">{{ s.title }}</a></li>
      {%- endfor %}
    </ul>
    <p><a href="{{ site.url }}/">Return to the home page</a></p>
  </article>
</div>
