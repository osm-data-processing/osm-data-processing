{# Inline SVG logo. Used in header (small) and hero (large) via CSS sizing. #}
<svg class="logo {{ logoClass | default('') }}" viewBox="0 0 96 96" role="img" aria-label="OSM Data Processing logo" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="logoSky" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#3aa885"/>
      <stop offset="100%" stop-color="#1f5a7d"/>
    </linearGradient>
    <linearGradient id="logoLand" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f4d58d"/>
      <stop offset="100%" stop-color="#e08e45"/>
    </linearGradient>
    <linearGradient id="logoFlow" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#6c5ce7"/>
      <stop offset="100%" stop-color="#d83a7a"/>
    </linearGradient>
  </defs>
  <circle cx="48" cy="48" r="44" fill="url(#logoSky)"/>
  <path d="M14 60 C 26 50, 36 66, 48 56 S 70 50, 82 60 L 82 84 L 14 84 Z" fill="url(#logoLand)" opacity="0.92"/>
  <path d="M14 50 C 28 42, 40 58, 54 48 S 78 44, 88 52" fill="none" stroke="url(#logoFlow)" stroke-width="3.2" stroke-linecap="round"/>
  <g fill="#fff" opacity="0.96">
    <circle cx="30" cy="36" r="3.2"/>
    <circle cx="58" cy="30" r="3.2"/>
    <circle cx="72" cy="48" r="3.2"/>
    <circle cx="40" cy="50" r="3.2"/>
  </g>
  <g stroke="#fff" stroke-width="1.6" opacity="0.85" fill="none" stroke-linecap="round">
    <line x1="30" y1="36" x2="40" y2="50"/>
    <line x1="40" y1="50" x2="58" y2="30"/>
    <line x1="58" y1="30" x2="72" y2="48"/>
    <line x1="40" y1="50" x2="72" y2="48"/>
  </g>
</svg>
